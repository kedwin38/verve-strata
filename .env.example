# ── Verve Strata — environment ────────────────────────────────────────────
# Copy to .env for local development. In production, set these as Railway
# service variables (never commit real values).

# Required — PostgreSQL connection string.
# Local: postgresql://postgres:postgres@localhost:5432/strata
# Railway: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/strata

# Required — ≥16 bytes of entropy; signs the session cookie layer.
SESSION_SECRET=change-me-to-a-long-random-string

# Required for storing user GitHub PATs — 64 hex chars (32 bytes).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=

# Optional — server-level GitHub token to raise API rate limits for
# unauthenticated workspaces. Never required; never written to disk.
GITHUB_TOKEN=

# Optional tuning
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
STRATA_MAX_DEPTH=60
STRATA_IMPORT_SAMPLE=100
